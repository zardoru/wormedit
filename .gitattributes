* text=auto

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.lua text eol=lf

# BMS-family fixtures may deliberately contain legacy encodings and CRLF.
*.bms -text
*.bme -text
*.bml -text
*.pms -text
# Editor clipboard payloads keep their exact CRLF bytes.
*.clip -text whitespace=cr-at-eol
*.sm text eol=lf
*.ssc text eol=lf
*.osu text eol=lf
*.bmson text eol=lf

*.flac binary
*.mid binary
*.midi binary
*.mp3 binary
*.ogg binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.webm binary
