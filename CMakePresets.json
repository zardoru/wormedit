{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless",
      "displayName": "Headless core and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "WORMEDIT_BUILD_APP": "OFF",
        "WORMEDIT_ENABLE_LUA": "ON"
      }
    },
    {
      "name": "headless-events",
      "displayName": "Headless core and windowless frontend event tests",
      "inherits": "headless",
      "binaryDir": "${sourceDir}/build/headless-events",
      "cacheVariables": {
        "WORMEDIT_BUILD_EVENT_HARNESS": "ON",
        "SDL_X11": "OFF",
        "SDL_WAYLAND": "OFF",
        "SDL_UNIX_CONSOLE_BUILD": "ON"
      }
    },
    {
      "name": "linux-cross-headless",
      "displayName": "Cross-compile headless core for Linux",
      "inherits": "headless",
      "binaryDir": "${sourceDir}/build/linux-cross-headless",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cross.cmake",
      "cacheVariables": {
        "WORMEDIT_LINUX_C_COMPILER": "$env{WORMEDIT_LINUX_C_COMPILER}",
        "WORMEDIT_LINUX_CXX_COMPILER": "$env{WORMEDIT_LINUX_CXX_COMPILER}",
        "WORMEDIT_LINUX_SYSROOT": "$env{WORMEDIT_LINUX_SYSROOT}",
        "WORMEDIT_LINUX_TARGET": "$env{WORMEDIT_LINUX_TARGET}",
        "WORMEDIT_CROSS_EMULATOR": "$env{WORMEDIT_CROSS_EMULATOR}"
      }
    },
    {
      "name": "windows-cross-headless",
      "displayName": "Cross-compile headless core for Windows",
      "inherits": "headless",
      "binaryDir": "${sourceDir}/build/windows-cross-headless",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-cross.cmake",
      "cacheVariables": {
        "WORMEDIT_ENABLE_VIDEO_DECODER": "OFF",
        "WORMEDIT_WINDOWS_C_COMPILER": "$env{WORMEDIT_WINDOWS_C_COMPILER}",
        "WORMEDIT_WINDOWS_CXX_COMPILER": "$env{WORMEDIT_WINDOWS_CXX_COMPILER}",
        "WORMEDIT_WINDOWS_RC_COMPILER": "$env{WORMEDIT_WINDOWS_RC_COMPILER}",
        "WORMEDIT_WINDOWS_SYSROOT": "$env{WORMEDIT_WINDOWS_SYSROOT}",
        "WORMEDIT_WINDOWS_TARGET": "$env{WORMEDIT_WINDOWS_TARGET}",
        "WORMEDIT_CROSS_EMULATOR": "$env{WORMEDIT_CROSS_EMULATOR}",
        "WORMEDIT_ENABLE_FFMPEG": "OFF"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Cross-compile the Windows application",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-cross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "WORMEDIT_BUILD_APP": "ON",
        "WORMEDIT_ENABLE_VIDEO_DECODER": "OFF",
        "WORMEDIT_WINDOWS_C_COMPILER": "$env{WORMEDIT_WINDOWS_C_COMPILER}",
        "WORMEDIT_WINDOWS_CXX_COMPILER": "$env{WORMEDIT_WINDOWS_CXX_COMPILER}",
        "WORMEDIT_WINDOWS_RC_COMPILER": "$env{WORMEDIT_WINDOWS_RC_COMPILER}",
        "WORMEDIT_WINDOWS_SYSROOT": "$env{WORMEDIT_WINDOWS_SYSROOT}",
        "WORMEDIT_WINDOWS_TARGET": "$env{WORMEDIT_WINDOWS_TARGET}",
        "WORMEDIT_ENABLE_FFMPEG": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Shipped Linux application (FFmpeg required)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "WORMEDIT_BUILD_APP": "ON",
        "WORMEDIT_ENABLE_AUDIO_DECODER": "ON",
        "WORMEDIT_ENABLE_VIDEO_DECODER": "ON",
        "WORMEDIT_ENABLE_FFMPEG": "ON",
        "WORMEDIT_REQUIRE_FFMPEG": "ON"
      }
    },
    {
      "name": "windows-cross-release",
      "displayName": "Shipped Windows application (cross-built FFmpeg required)",
      "inherits": "windows-cross",
      "binaryDir": "${sourceDir}/build/windows-cross-release",
      "cacheVariables": {
        "WORMEDIT_ENABLE_AUDIO_DECODER": "ON",
        "WORMEDIT_ENABLE_VIDEO_DECODER": "ON",
        "WORMEDIT_ENABLE_FFMPEG": "ON",
        "WORMEDIT_REQUIRE_FFMPEG": "ON",
        "WORMEDIT_ENABLE_LUA": "ON"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang with libstdc++",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-clang-libcxx",
      "displayName": "Linux Clang with libc++",
      "inherits": "linux-clang",
      "binaryDir": "${sourceDir}/build-clang-libcxx",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "wasm-smoke",
      "displayName": "Post-1.0 experimental browser codec smoke",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-smoke",
      "toolchainFile": "${sourceDir}/cmake/toolchains/wasm.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "WORMEDIT_BUILD_WASM_SMOKE": "ON",
        "WORMEDIT_BUILD_APP": "OFF",
        "WORMEDIT_BUILD_EVENT_HARNESS": "OFF",
        "WORMEDIT_ENABLE_LUA": "OFF",
        "WORMEDIT_ENABLE_AUDIO_DECODER": "OFF",
        "WORMEDIT_ENABLE_IMAGE_DECODER": "OFF",
        "WORMEDIT_ENABLE_VIDEO_DECODER": "OFF",
        "WORMEDIT_ENABLE_FFMPEG": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_Iconv": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "headless-events",
      "configurePreset": "headless-events"
    },
    {
      "name": "linux-cross-headless",
      "configurePreset": "linux-cross-headless"
    },
    {
      "name": "windows-cross-headless",
      "configurePreset": "windows-cross-headless"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "windows-cross-release",
      "configurePreset": "windows-cross-release",
      "jobs": 4
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "jobs": 4
    },
    {
      "name": "linux-clang-libcxx",
      "configurePreset": "linux-clang-libcxx",
      "jobs": 4
    },
    {
      "name": "wasm-smoke",
      "configurePreset": "wasm-smoke",
      "targets": [
        "wormedit-wasm-smoke"
      ],
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-events",
      "configurePreset": "headless-events",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cross-headless",
      "configurePreset": "linux-cross-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cross-headless",
      "configurePreset": "windows-cross-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "execution": {
        "jobs": 2
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-libcxx",
      "configurePreset": "linux-clang-libcxx",
      "execution": {
        "jobs": 2
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
