# Fails when a name in docs/architecture.md's "Where to look" table no longer exists in the source.
# Rows tagged with a card, *(T-NNN)*, name shapes still being built and are skipped until the card
# removes its tag.
if(NOT WORMEDIT_SOURCE_ROOT)
    message(FATAL_ERROR "WORMEDIT_SOURCE_ROOT is required")
endif()
file(STRINGS "${WORMEDIT_SOURCE_ROOT}/docs/architecture.md" lines)
set(in_table FALSE)
set(paths "")
set(names "")
foreach(line IN LISTS lines)
    if(line MATCHES "^## Where to look")
        set(in_table TRUE)
        continue()
    elseif(line MATCHES "^## ")
        set(in_table FALSE)
    endif()
    if(NOT in_table OR NOT line MATCHES "^\\| " OR line MATCHES "^\\| To find" OR line MATCHES "^\\|---")
        continue()
    endif()
    if(line MATCHES "\\*\\((T-[0-9]+)\\)\\*")
        message(STATUS "Skipping a row tagged ${CMAKE_MATCH_1}: ${line}")
        continue()
    endif()
    string(REGEX MATCHALL "`[^`]+`" tokens "${line}")
    foreach(token IN LISTS tokens)
        string(REGEX REPLACE "^`|`$" "" token "${token}")
        string(REGEX REPLACE "[<(].*$" "" token "${token}")
        if(token MATCHES "/")
            list(APPEND paths "${token}")
        elseif(token MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            list(APPEND names "${token}")
        endif()
    endforeach()
endforeach()
if(NOT paths AND NOT names)
    message(FATAL_ERROR "docs/architecture.md has no \"Where to look\" names to check")
endif()
set(failed FALSE)
foreach(path IN LISTS paths)
    if(NOT EXISTS "${WORMEDIT_SOURCE_ROOT}/${path}")
        message(SEND_ERROR "docs/architecture.md names a missing path: ${path}")
        set(failed TRUE)
    endif()
endforeach()
list(REMOVE_DUPLICATES names)
file(GLOB_RECURSE sources "${WORMEDIT_SOURCE_ROOT}/src/*.h" "${WORMEDIT_SOURCE_ROOT}/src/*.cpp"
     "${WORMEDIT_SOURCE_ROOT}/include/*.h")
set(missing "${names}")
foreach(file IN LISTS sources)
    if(NOT missing)
        break()
    endif()
    file(READ "${file}" content)
    foreach(name IN LISTS missing)
        string(REGEX MATCH "(^|[^A-Za-z0-9_])${name}([^A-Za-z0-9_]|$)" hit "${content}")
        if(hit)
            list(REMOVE_ITEM missing "${name}")
        endif()
    endforeach()
endforeach()
foreach(name IN LISTS missing)
    message(SEND_ERROR "docs/architecture.md names a symbol not found in src/ or include/: ${name}")
    set(failed TRUE)
endforeach()
if(failed)
    message(FATAL_ERROR "Update docs/architecture.md to the current names")
endif()
list(LENGTH paths path_count)
list(LENGTH names name_count)
message(STATUS "docs/architecture.md: ${path_count} paths and ${name_count} names found")
