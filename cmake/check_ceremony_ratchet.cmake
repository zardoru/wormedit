# Fails when a known ceremony pattern grows past its recorded maximum (cmake/ceremony_ratchet.txt).
if(NOT WORMEDIT_SOURCE_ROOT)
    message(FATAL_ERROR "WORMEDIT_SOURCE_ROOT is required")
endif()
file(STRINGS "${WORMEDIT_SOURCE_ROOT}/cmake/ceremony_ratchet.txt" rows)
set(failed FALSE)
foreach(row IN LISTS rows)
    if(row MATCHES "^#" OR row STREQUAL "")
        continue()
    endif()
    if(NOT row MATCHES "^([a-z_]+) \\| ([0-9]+) \\| ([a-z/,]+) \\| (.+)$")
        message(FATAL_ERROR "Malformed ratchet row: ${row}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(maximum "${CMAKE_MATCH_2}")
    string(REPLACE "," ";" directories "${CMAKE_MATCH_3}")
    set(pattern "${CMAKE_MATCH_4}")
    set(count 0)
    set(where "")
    foreach(directory IN LISTS directories)
        file(GLOB_RECURSE files "${WORMEDIT_SOURCE_ROOT}/${directory}/*.h" "${WORMEDIT_SOURCE_ROOT}/${directory}/*.hpp"
             "${WORMEDIT_SOURCE_ROOT}/${directory}/*.cpp")
        foreach(file IN LISTS files)
            file(STRINGS "${file}" hits REGEX "${pattern}")
            list(LENGTH hits n)
            if(n GREATER 0)
                math(EXPR count "${count} + ${n}")
                file(RELATIVE_PATH relative "${WORMEDIT_SOURCE_ROOT}" "${file}")
                list(APPEND where "${relative}:${n}")
            endif()
        endforeach()
    endforeach()
    if(count GREATER maximum)
        list(JOIN where ", " where_text)
        message(SEND_ERROR "Ceremony ratchet '${name}': ${count} > maximum ${maximum} (${where_text}). Use the shared owner instead of a new copy; see code-style.md \"Ratchets\".")
        set(failed TRUE)
    elseif(count LESS maximum)
        message(STATUS "Ceremony ratchet '${name}': ${count} < maximum ${maximum}; lower it in cmake/ceremony_ratchet.txt.")
    else()
        message(STATUS "Ceremony ratchet '${name}': ${count}")
    endif()
endforeach()
if(failed)
    message(FATAL_ERROR "Ceremony ratchet failed")
endif()
