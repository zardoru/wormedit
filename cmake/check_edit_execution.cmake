cmake_minimum_required(VERSION 3.25)

# Freeze the reviewed footprint of legacy edit orchestration across all first-party code.
# New edits compose through document_command_transaction_t::stage; see docs/audits/edit-execution.md.
if(NOT WORMEDIT_SOURCE_ROOT)
    message(FATAL_ERROR "WORMEDIT_SOURCE_ROOT is required")
endif()
set(patterns
    "scratch_history|document_history_t::from\\("
    "working_document|[.]document\\(|transaction[.]chart\\("
    "document_adoption|[.]adopt_document\\("
    "detached_document|(auto|song_document_t) +[a-zA-Z_][a-zA-Z_0-9]* += +(context[.])?history[.]document.$")
set(runners include/wormedit/core/command.h src/core/command.cpp src/core/interaction_edit_commit.h)
file(STRINGS "${WORMEDIT_SOURCE_ROOT}/cmake/edit_execution_allowances.txt" rows)
set(allowances)
foreach(row IN LISTS rows)
    if(row MATCHES "^#" OR row STREQUAL "")
        continue()
    endif()
    if(NOT row MATCHES "^([a-z_]+) \\| ([a-zA-Z0-9_./-]+) \\| ([1-9][0-9]*) \\| (.+)$")
        message(FATAL_ERROR "Malformed edit execution allowance: ${row}")
    endif()
    set(key "allowance:${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
    if(DEFINED "${key}")
        message(FATAL_ERROR "Duplicate edit execution allowance: ${row}")
    endif()
    set("${key}" "${CMAKE_MATCH_3}")
    list(APPEND allowances "${key}")
endforeach()
file(GLOB_RECURSE files
    "${WORMEDIT_SOURCE_ROOT}/src/*.cpp" "${WORMEDIT_SOURCE_ROOT}/src/*.h"
    "${WORMEDIT_SOURCE_ROOT}/src/*.hpp"
    "${WORMEDIT_SOURCE_ROOT}/include/*.h" "${WORMEDIT_SOURCE_ROOT}/include/*.hpp")
foreach(file IN LISTS files)
    file(RELATIVE_PATH relative "${WORMEDIT_SOURCE_ROOT}" "${file}")
    if(relative IN_LIST runners)
        continue()
    endif()
    foreach(pattern IN LISTS patterns)
        string(REGEX MATCH "^([^|]+)\\|(.+)$" matched "${pattern}")
        if(NOT matched)
            message(FATAL_ERROR "Malformed edit execution pattern: ${pattern}")
        endif()
        set(kind "${CMAKE_MATCH_1}")
        set(expression "${CMAKE_MATCH_2}")
        file(STRINGS "${file}" hits REGEX "${expression}")
        list(LENGTH hits count)
        set(key "allowance:${kind}:${relative}")
        if(DEFINED "${key}")
            if(NOT count EQUAL "${${key}}")
                message(SEND_ERROR "Edit execution ${kind}: ${relative}: ${count} lines, allowance ${${key}}. Use the shared staging runner; reductions require lowering the reviewed allowance.")
            endif()
            list(REMOVE_ITEM allowances "${key}")
        elseif(count GREATER 0)
            message(SEND_ERROR "New manual edit orchestration (${kind}) in ${relative}: ${count} lines. Use document_command_transaction_t::stage.")
        endif()
    endforeach()
endforeach()
if(allowances)
    message(SEND_ERROR "Stale edit execution allowances: ${allowances}")
endif()
message(STATUS "Edit execution footprint checked across all first-party sources")
