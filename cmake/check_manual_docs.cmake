# Checks the AsciiDoc manual: every include and image exists, every <<id>> cross-reference has a
# [#id] anchor, and every {shot-<id>-revision} caption has a recorded capture.
if(NOT WORMEDIT_SOURCE_ROOT)
    message(FATAL_ERROR "WORMEDIT_SOURCE_ROOT is required")
endif()
set(manual "${WORMEDIT_SOURCE_ROOT}/docs/manual")
file(GLOB_RECURSE documents "${manual}/*.adoc")
set(failures "")
set(anchors "")
set(references "")
set(revision_uses "")
foreach(document IN LISTS documents)
    get_filename_component(directory "${document}" DIRECTORY)
    file(RELATIVE_PATH name "${WORMEDIT_SOURCE_ROOT}" "${document}")
    file(STRINGS "${document}" lines)
    foreach(line IN LISTS lines)
        if(line MATCHES "^include::([^[]+)\\[")
            if(NOT EXISTS "${directory}/${CMAKE_MATCH_1}")
                list(APPEND failures "${name}: missing include ${CMAKE_MATCH_1}")
            endif()
        endif()
        if(line MATCHES "^image::([^[]+)\\[")
            if(NOT EXISTS "${manual}/images/${CMAKE_MATCH_1}")
                list(APPEND failures "${name}: missing image ${CMAKE_MATCH_1}")
            endif()
        endif()
        if(line MATCHES "^\\[#([A-Za-z0-9_-]+)\\]")
            list(APPEND anchors "${CMAKE_MATCH_1}")
        endif()
        string(REGEX MATCHALL "<<[A-Za-z0-9_-]+" found "${line}")
        foreach(reference IN LISTS found)
            string(SUBSTRING "${reference}" 2 -1 reference)
            list(APPEND references "${name}|${reference}")
        endforeach()
        string(REGEX MATCHALL "{shot-[A-Za-z0-9_-]+-revision}" found "${line}")
        foreach(use IN LISTS found)
            list(APPEND revision_uses "${name}|${use}")
        endforeach()
    endforeach()
endforeach()
foreach(entry IN LISTS references)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 reference)
    if(NOT reference IN_LIST anchors)
        list(APPEND failures "${name}: no anchor for <<${reference}>>")
    endif()
endforeach()
set(recorded "")
if(EXISTS "${manual}/images/revisions.adoc")
    file(STRINGS "${manual}/images/revisions.adoc" recorded REGEX "^:shot-")
endif()
foreach(entry IN LISTS revision_uses)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 use)
    string(REGEX REPLACE "^{(.*)}$" ":\\1:" attribute "${use}")
    set(found FALSE)
    foreach(line IN LISTS recorded)
        string(FIND "${line}" "${attribute}" at)
        if(at EQUAL 0)
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        list(APPEND failures "${name}: ${use} has no capture; run scripts/manual-captures.sh")
    endif()
endforeach()
if(failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "Manual check failed:\n  ${text}")
endif()
list(LENGTH documents count)
message(STATUS "Manual check: ${count} documents")
