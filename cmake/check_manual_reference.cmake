# Compares docs/manual/generated/ with wormedit-manual-reference output, or rewrites it when
# WORMEDIT_WRITE is set (the manual-reference build target).
if(NOT WORMEDIT_SOURCE_ROOT OR NOT WORMEDIT_MANUAL_REFERENCE)
    message(FATAL_ERROR "WORMEDIT_SOURCE_ROOT and WORMEDIT_MANUAL_REFERENCE are required")
endif()
set(stale "")
foreach(kind shortcuts layouts)
    execute_process(COMMAND "${WORMEDIT_MANUAL_REFERENCE}" ${kind}
        OUTPUT_VARIABLE generated RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "wormedit-manual-reference ${kind} failed (${result})")
    endif()
    set(path "${WORMEDIT_SOURCE_ROOT}/docs/manual/generated/${kind}.adoc")
    if(WORMEDIT_WRITE)
        file(WRITE "${path}" "${generated}")
        continue()
    endif()
    set(checked_in "")
    if(EXISTS "${path}")
        file(READ "${path}" checked_in)
    endif()
    if(NOT checked_in STREQUAL generated)
        list(APPEND stale "docs/manual/generated/${kind}.adoc")
    endif()
endforeach()
if(stale)
    list(JOIN stale ", " stale_text)
    message(FATAL_ERROR "Stale manual reference: ${stale_text}. Run `cmake --build build --target manual-reference` and review the diff.")
endif()
