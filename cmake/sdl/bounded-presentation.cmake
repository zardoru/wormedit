# Build private, audited translation-unit overrides; never edit a selected SDL tree.
function(wormedit_enable_bounded_sdl_presentation sdl_source_directory)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(platform linux)
        set(override_files src/render/gpu/SDL_render_gpu.c src/gpu/vulkan/SDL_gpu_vulkan.c)
    elseif(APPLE)
        set(platform metal)
        set(override_files src/gpu/metal/SDL_gpu_metal.m)
    else()
        message(STATUS "SDL presentation override leaves this platform backend unchanged")
        return()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(override_root "${CMAKE_BINARY_DIR}/wormedit-sdl-override")
    set(patch_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${patch_root}/patch_bounded_presentation.py"
        --source "${sdl_source_directory}" --output "${override_root}"
        --helpers "${patch_root}/bounded_present_vulkan.inc" --platform "${platform}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot prepare the audited SDL presentation override: ${output}${error}")
    endif()
    set(changed_targets 0)
    foreach(target SDL3-shared SDL3-static)
        if(NOT TARGET "${target}")
            continue()
        endif()
        get_target_property(sources "${target}" SOURCES)
        get_target_property(source_root "${target}" SOURCE_DIR)
        set(replaced_sources)
        foreach(source IN LISTS sources)
            set(replacement "${source}")
            if(NOT source MATCHES "^\\$<")
                get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${source_root}")
                foreach(relative IN LISTS override_files)
                    get_filename_component(original "${sdl_source_directory}/${relative}" ABSOLUTE)
                    if(absolute STREQUAL original)
                        set(replacement "${override_root}/${relative}")
                        get_filename_component(original_directory "${original}" DIRECTORY)
                        set_property(SOURCE "${replacement}" TARGET_DIRECTORY "${target}"
                            APPEND PROPERTY INCLUDE_DIRECTORIES "${original_directory}")
                    endif()
                endforeach()
            endif()
            list(APPEND replaced_sources "${replacement}")
        endforeach()
        set_property(TARGET "${target}" PROPERTY SOURCES "${replaced_sources}")
        math(EXPR changed_targets "${changed_targets} + 1")
    endforeach()
    if(changed_targets EQUAL 0)
        message(FATAL_ERROR "SDL targets must exist before applying the presentation override")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${patch_root}/patch_bounded_presentation.py" "${patch_root}/bounded_present_vulkan.inc")
    foreach(relative IN LISTS override_files)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sdl_source_directory}/${relative}")
    endforeach()
endfunction()
