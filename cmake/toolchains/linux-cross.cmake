set(CMAKE_SYSTEM_NAME Linux)

set(WORMEDIT_LINUX_C_COMPILER "" CACHE FILEPATH "Linux-targeting C compiler")
set(WORMEDIT_LINUX_CXX_COMPILER "" CACHE FILEPATH "Linux-targeting C++ compiler")
set(WORMEDIT_LINUX_SYSROOT "" CACHE PATH "Linux target sysroot")
set(WORMEDIT_LINUX_TARGET "" CACHE STRING "Optional compiler target triple")
set(WORMEDIT_CROSS_EMULATOR "" CACHE FILEPATH "Optional target executable emulator")

if(NOT WORMEDIT_LINUX_C_COMPILER OR NOT WORMEDIT_LINUX_CXX_COMPILER)
    message(FATAL_ERROR
        "Set WORMEDIT_LINUX_C_COMPILER and WORMEDIT_LINUX_CXX_COMPILER "
        "to the Linux-targeting compiler executables.")
endif()

set(CMAKE_C_COMPILER "${WORMEDIT_LINUX_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${WORMEDIT_LINUX_CXX_COMPILER}")

if(WORMEDIT_LINUX_SYSROOT)
    set(CMAKE_SYSROOT "${WORMEDIT_LINUX_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH "${WORMEDIT_LINUX_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()

if(WORMEDIT_LINUX_TARGET)
    set(CMAKE_C_COMPILER_TARGET "${WORMEDIT_LINUX_TARGET}")
    set(CMAKE_CXX_COMPILER_TARGET "${WORMEDIT_LINUX_TARGET}")
endif()

if(WORMEDIT_CROSS_EMULATOR)
    set(CMAKE_CROSSCOMPILING_EMULATOR "${WORMEDIT_CROSS_EMULATOR}")
endif()
