set(CMAKE_SYSTEM_NAME Windows)

set(WORMEDIT_WINDOWS_C_COMPILER "" CACHE FILEPATH "Windows-targeting C compiler")
set(WORMEDIT_WINDOWS_CXX_COMPILER "" CACHE FILEPATH "Windows-targeting C++ compiler")
set(WORMEDIT_WINDOWS_RC_COMPILER "" CACHE FILEPATH "Optional Windows resource compiler")
set(WORMEDIT_WINDOWS_SYSROOT "" CACHE PATH "Windows target sysroot")
set(WORMEDIT_WINDOWS_TARGET "" CACHE STRING "Optional compiler target triple")
set(WORMEDIT_CROSS_EMULATOR "" CACHE FILEPATH "Optional target executable emulator such as Wine")

if(NOT WORMEDIT_WINDOWS_C_COMPILER OR NOT WORMEDIT_WINDOWS_CXX_COMPILER)
    message(FATAL_ERROR
        "Set WORMEDIT_WINDOWS_C_COMPILER and WORMEDIT_WINDOWS_CXX_COMPILER "
        "to the Windows-targeting compiler executables.")
endif()

set(CMAKE_C_COMPILER "${WORMEDIT_WINDOWS_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${WORMEDIT_WINDOWS_CXX_COMPILER}")

if(WORMEDIT_WINDOWS_RC_COMPILER)
    set(CMAKE_RC_COMPILER "${WORMEDIT_WINDOWS_RC_COMPILER}")
endif()

if(WORMEDIT_WINDOWS_SYSROOT)
    set(CMAKE_SYSROOT "${WORMEDIT_WINDOWS_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH "${WORMEDIT_WINDOWS_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()

if(WORMEDIT_WINDOWS_TARGET)
    set(CMAKE_C_COMPILER_TARGET "${WORMEDIT_WINDOWS_TARGET}")
    set(CMAKE_CXX_COMPILER_TARGET "${WORMEDIT_WINDOWS_TARGET}")
endif()

if(WORMEDIT_CROSS_EMULATOR)
    set(CMAKE_CROSSCOMPILING_EMULATOR "${WORMEDIT_CROSS_EMULATOR}")
endif()
